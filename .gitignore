# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/

# Environment variables (Never commit real AWS credentials)
.env

# SQLite local databases and data files (keep directory)
data/*.db
data/*.sqlite3
data/*.csv
!data/.gitkeep

# Saved ML models (keep directory)
models/*.joblib
models/*.pkl
!models/.gitkeep

# Streamlit runtime & cache
.streamlit/

# OS specific files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# IDE configs
.vscode/
.idea/
