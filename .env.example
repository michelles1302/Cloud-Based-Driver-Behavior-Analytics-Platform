# Amazon Web Services (AWS) Configuration - OPTIONAL
# Leave empty or keep unset to run the platform in 100% Local Mode (default).
# To enable optional S3 telemetry backups:
# 1. Copy this file to .env
# 2. Fill in your AWS credentials and S3 bucket name.

AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=my-driver-analytics-bucket
